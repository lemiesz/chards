{
  "name": "chards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "verify:browser": "node scripts/smoke.mjs",
    "verify:game": "node scripts/autoplay.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "verify:ai": "node scripts/ai-smoke.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:4173",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name chards"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  }
}
